# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# --- API ---
PORT=4000
# Origin frontend yang diizinkan CORS. Pisahkan dengan koma bila lebih dari satu.
FRONTEND_ORIGIN=http://localhost:3000

# --- Redis (antrean BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Penyimpanan hasil ---
# HARUS sama untuk API dan worker (satu mesin atau satu volume bersama).
DATA_DIR=./data

# --- Worker ---
# Jumlah clip/job yang diproses bersamaan per proses worker.
WORKER_CONCURRENCY=2
# Batas waktu (detik) untuk mode vod / past. Mode record = durasi clip + 180 dtk.
CLIP_TIMEOUT_SEC=300
# 1 = potong akurat per frame (re-encode, JAUH lebih lambat). Default 0.
FORCE_KEYFRAMES=0
# 1 = tampilkan semua output yt-dlp di log worker.
DEBUG_YTDLP=0
